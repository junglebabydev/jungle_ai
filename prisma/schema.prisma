// ── Sprint 1 Track 1 — Stripe Connect models ─────────────────────────────────

/// One-to-one with Merchant — tracks the merchant's Stripe Connect Express
/// account state (charges/payouts capability flags, onboarding progress).
model MerchantStripeAccount {
  id         Int      @id @default(autoincrement())
  merchantId Int      @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  stripeAccountId     String  @unique
  chargesEnabled      Boolean @default(false)
  payoutsEnabled      Boolean @default(false)
  detailsSubmitted    Boolean @default(false)
  disabledReason      String?
  country             String  @default("SG")
  defaultCurrency     String  @default("sgd")
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeAccountId])
}

/// Transaction-level record of every parent payment (one-time PaymentIntent
/// or subscription invoice payment). Source of truth at the transaction
/// level; `Booking.paymentStatus` is derived.
model Payment {
  id        Int    @id @default(autoincrement())
  paymentID String @default(uuid())

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  bookingId Int?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  paymentIntentId  String? @unique
  subscriptionId   String?
  invoiceId        String?
  hostedInvoiceUrl String?
  invoicePdfUrl    String?

  amount               Int
  currency             String                @default("sgd")
  applicationFeeAmount Int
  paymentMethod        PAYMENT_METHOD
  status               STRIPE_PAYMENT_STATUS
  failureReason        String?
  refundedAmount       Int                   @default(0)
  metadata             Json?
  customerEmail        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disputes Dispute[]

  @@index([merchantId, status])
  @@index([userId])
  @@index([bookingId])
  @@index([subscriptionId])
}

/// Mirror of Stripe payout objects. Hydrated from `payout.created`,
/// `payout.paid`, `payout.failed` Connect webhooks.
model Payout {
  id       Int    @id @default(autoincrement())
  payoutID String @default(uuid())

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  stripePayoutId String        @unique
  amount         Int
  currency       String        @default("sgd")
  status         PAYOUT_STATUS
  arrivalDate    DateTime?
  failureCode    String?
  failureMessage String?
  method         String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, status])
}

/// Stripe charge dispute. Hydrated from `charge.dispute.*` webhooks.
/// Critical: merchants must be notified urgently (evidence deadlines).
model Dispute {
  id        Int    @id @default(autoincrement())
  disputeID String @default(uuid())

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  stripeDisputeId String         @unique
  stripeChargeId  String
  amount          Int
  currency        String         @default("sgd")
  reason          String
  status          DISPUTE_STATUS
  evidenceDueBy   DateTime?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, status])
}

/// Idempotency layer for Stripe webhooks. Every event upserts on event.id.
/// `processedAt = null` rows are the replay backlog.
model StripeEvent {
  id           Int      @id @default(autoincrement())
  eventId      String   @unique
  type         String
  processedAt  DateTime @default(now())
  payload      Json
  status       String   @default("processed")
  errorMessage String?

  @@index([type])
  @@index([processedAt])
}

// ── Sprint 2 Track 1: Jungle SaaS billing (merchant → Jungle) ─────────────────
//
// Distinct from Sprint 1's Stripe Connect subscriptions (which are
// parent → merchant). These run on Jungle's main Stripe account and use
// `application_fee_percent` of N/A (Jungle keeps 100% of the SaaS fee).
//
// Webhook channel: PLATFORM events (event.account is undefined). Routed by
// the dispatcher per Decision #14.

enum JUNGLE_SUBSCRIPTION_STATUS {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  INCOMPLETE
}

/// One row per pricing tier Jungle offers (Starter / Growth / Pro).
/// `features` and `limits` are JSONB blobs queried by the plan-limits
/// middleware. Stripe Price IDs link to the Products created on Jungle's
/// main Stripe account (NOT Connect accounts).
model JunglePlan {
  id                   Int      @id @default(autoincrement())
  name                 String
  slug                 String   @unique
  description          String?
  monthlyPrice         Int // cents
  yearlyPrice          Int? // cents (optional)
  stripePriceIdMonthly String   @unique
  stripePriceIdYearly  String?  @unique
  features             Json // { booking_system: true, website_builder: true, ai_agent: false, ... }
  limits               Json // { max_products: 50, max_locations: 1, max_bookings_per_month: 500, ... }
  trialDays            Int      @default(14)
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions MerchantSubscription[]
}

/// One subscription per merchant — they are subscribed to exactly one plan
/// at a time. `stripeCustomerId` is set early (when the merchant first hits
/// the subscribe endpoint, even before a successful payment); `stripeSubscriptionId`
/// only appears after the parent completes Stripe Checkout and the webhook fires.
model MerchantSubscription {
  id                   Int                        @id @default(autoincrement())
  merchantId           Int                        @unique
  merchant             Merchant                   @relation(fields: [merchantId], references: [id])
  planId               Int
  plan                 JunglePlan                 @relation(fields: [planId], references: [id])
  stripeCustomerId     String                     @unique
  stripeSubscriptionId String?                    @unique
  status               JUNGLE_SUBSCRIPTION_STATUS @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAt             DateTime?
  canceledAt           DateTime?
  billingInterval      BILLING_INTERVAL           @default(MONTH)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  invoices JungleInvoice[]

  @@index([status])
  @@index([stripeSubscriptionId])
}

/// Mirror of Stripe invoices on Jungle's main account. Hydrated by
/// `invoice.paid` and `invoice.payment_failed` webhooks (platform channel).
model JungleInvoice {
  id                     Int                  @id @default(autoincrement())
  merchantSubscriptionId Int
  merchantSubscription   MerchantSubscription @relation(fields: [merchantSubscriptionId], references: [id])
  stripeInvoiceId        String               @unique
  amount                 Int // cents
  currency               String               @default("sgd")
  status                 String // 'paid' | 'open' | 'void' | 'uncollectible'
  hostedInvoiceUrl       String?
  invoicePdfUrl          String?
  periodStart            DateTime
  periodEnd              DateTime
  paidAt                 DateTime?
  createdAt              DateTime             @default(now())

  @@index([merchantSubscriptionId])
}

/// Sprint 2 Track 2 — Website builder.
/// One row per merchant. Holds top-level site config plus published-snapshot
/// columns (publishedXJson) so the live render reads frozen state while the
/// merchant edits draft fields on this same row.
model MerchantSiteConfig {
  id         Int      @id @default(autoincrement())
  merchantId Int      @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  // Draft: typography
  displayFontFamily String?
  bodyFontFamily    String?

  // Draft: branding / chrome
  logoUrl    String?
  faviconUrl String?
  ogImageUrl String?

  // Draft: SEO
  seoTitle       String?
  seoDescription String?
  siteName       String?

  // Draft: behavior flags
  isPublic           Boolean @default(true)
  maintenanceMode    Boolean @default(false)
  showPoweredBy      Boolean @default(true)
  allowGuestCheckout Boolean @default(true)

  // Draft: integrations
  googleAnalyticsId String?

  // Draft: theme
  pageSurfaceColor String?

  // Site subdomain slug (e.g., "mystore" for mystore.jungle.baby)
  // Must be unique, lowercase, alphanumeric with hyphens
  // Max 63 chars (DNS label limit)
  slug String? @unique @db.VarChar(63)

  // Custom domain (e.g., "impressions.com" or "littleexplorers.sg")
  // Merchant's own domain that points to their Jungle site
  customDomain String? @unique @db.VarChar(255)

  // Published snapshot of the draft config above. Live render reads from here.
  publishedConfigJson Json?

  // Lifecycle
  hasDraftChanges Boolean   @default(false)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  lastBuildAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages        SitePage[]
  chromeBlocks SiteChromeBlock[]

  @@index([merchantId])
}

/// A page under a merchant's site config. `pageKey` is a stable system key
/// (e.g. "home", "classes") used for system pages; `slug` is the public URL
/// segment.
model SitePage {
  id           Int                @id @default(autoincrement())
  siteConfigId Int
  siteConfig   MerchantSiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  slug            String
  title           String
  metaTitle       String?
  metaDescription String?

  isVisible    Boolean @default(true)
  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  pageKey            String
  isSystem           Boolean @default(false)
  productCategoryRef String?

  // Published snapshot of this page's draft fields above.
  publishedPageJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections SiteSection[]

  @@unique([siteConfigId, slug])
  @@unique([siteConfigId, pageKey])
  @@index([siteConfigId, isPublished])
}

/// A section on a page (hero, feature grid, contact, etc.).
/// `type` is the discriminator that selects the shared TS content shape;
/// `contentJson` carries the variant payload validated by the matching Zod
/// schema in WebsiteDTOs.
model SiteSection {
  id     Int      @id @default(autoincrement())
  pageId Int
  page   SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type         String
  sectionKey   String
  name         String
  contentJson  Json
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  // Published snapshot of the section's draft fields above.
  publishedSectionJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components SiteSectionComponent[]

  @@unique([pageId, sectionKey])
  @@index([pageId, displayOrder])
}

/// A component nested inside a section. Components carry no content of their
/// own at the row level (parent section owns content via contentJson); they
/// exist so the editor can reorder/toggle visibility per sub-element.
model SiteSectionComponent {
  id        Int         @id @default(autoincrement())
  sectionId Int
  section   SiteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  componentKey String
  name         String
  isVisible    Boolean @default(true)
  displayOrder Int     @default(0)

  // Published snapshot of the component's draft fields above.
  publishedComponentJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, componentKey])
  @@index([sectionId, displayOrder])
}

/// Header / footer / nav blocks scoped to a site config (not a page).
/// `blockKey` is a stable identifier ("header", "footer", "primary-nav").
model SiteChromeBlock {
  id           Int                @id @default(autoincrement())
  siteConfigId Int
  siteConfig   MerchantSiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  blockKey    String
  isVisible   Boolean @default(true)
  contentJson Json

  // Published snapshot of the chrome block's draft fields above.
  publishedChromeJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteConfigId, blockKey])
}

// =============================================================================
// AI merchant-config chat — agent loop + tool calls + eval logging.
// Conversation/turns are DB-backed (the service process is stateless, rule 05)
// and double as the eval-replay store. merchant/location/user are referenced by
// scalar id (denormalized, append-only log tables) to avoid back-relations on
// the core auth models; integrity within the Ai* subsystem uses real relations.
// =============================================================================

enum AI_TURN_ROLE {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AI_PENDING_STATUS {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

model AiConversation {
  id               Int    @id @default(autoincrement())
  aiConversationID String @unique @default(uuid())

  // Verified, pinned scope for the whole conversation (client-supplied, then
  // ownership-checked at creation). Scalar refs — no back-relation on the core
  // models. The agent dispatcher pins these onto every tool call.
  // locationId is OPTIONAL: a conversation may be merchant-scoped (no active
  // location). When null, the agent resolves a target location on demand (the
  // merchant's sole location, else it asks / guides them to add one).
  merchantId Int
  locationId Int?
  userId     Int

  model            String
  systemPromptHash String

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns          AiTurn[]
  pendingActions AiPendingAction[]

  @@index([merchantId])
  @@index([userId])
}

model AiTurn {
  id       Int    @id @default(autoincrement())
  aiTurnID String @unique @default(uuid())

  conversationId Int
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sequence Int
  role     AI_TURN_ROLE
  content  String       @db.Text

  // Provider extras for exact replay: the assistant `tool_calls` array, and the
  // OpenAI `tool_call_id` a TOOL turn replies to.
  toolCallId String?
  rawJson    Json?

  createdAt DateTime @default(now())

  @@index([conversationId, sequence])
}

model AiPendingAction {
  id                Int    @id @default(autoincrement())
  aiPendingActionID String @unique @default(uuid())
  nonce             String @unique @default(uuid())

  conversationId Int
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  toolName String
  argsJson Json
  status   AI_PENDING_STATUS @default(PENDING)

  expiresAt  DateTime
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([nonce])
}

// =============================================================================
// Concierge (parent-facing discovery chat). A PUBLIC, read-only conversational
// layer over the unified search — distinct from the merchant AiConversation
// above, which hard-requires merchantId + userId and is wired to RBAC + confirm
// gates. The concierge has NO tenant and NO user: it's anonymous and searches
// the whole PUBLIC catalogue. Persistence is keyed on the unguessable
// `conciergeConversationID` uuid (the capability handle the client stores +
// resends) — there is no numeric-id enumeration and no login. Reuses AI_TURN_ROLE.
// =============================================================================

model ConciergeConversation {
  id                      Int    @id @default(autoincrement())
  // The PUBLIC handle: an unguessable uuid the client stores (localStorage) and
  // sends back to resume. This is the anonymous capability — never expose `id`.
  conciergeConversationID String @unique @default(uuid())

  model String

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns ConciergeTurn[]
}

model ConciergeTurn {
  id Int @id @default(autoincrement())

  conversationId Int
  conversation   ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sequence Int
  role     AI_TURN_ROLE
  content  String       @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId, sequence])
}

// =============================================================================
// WhatsApp channel (Meta Cloud API). A new transport in front of the SAME agent
// loop (runTurn / executeConfirmation). Scope is derived ONLY from a verified
// WhatsappLink — never from the message payload — so the agent's existing
// in-process RBAC/ownership re-check (src/agent/dispatch) stays valid here.
// Inbound is processed async via a Postgres-backed queue (WhatsappInboundJob,
// claimed with SELECT … FOR UPDATE SKIP LOCKED) so the webhook ACKs Meta in
// <5s while a slow agent turn runs out-of-band. Scalar id refs (denormalized),
// matching the Ai* subsystem above.
// =============================================================================

enum WHATSAPP_LINK_STATUS {
  PENDING // link code issued, phone not yet bound
  ACTIVE // phone bound + verified
  REVOKED // unlinked by the merchant
}

enum WHATSAPP_JOB_STATUS {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// A verified binding: one WhatsApp phone number → one user acting in one
// merchant/location scope. v1 constraint: a phone maps to exactly ONE scope
// (phoneE164 is unique). Re-linking a phone reassigns the existing row.
model WhatsappLink {
  id             Int    @id @default(autoincrement())
  whatsappLinkID String @unique @default(uuid())

  // Null until the one-time code is redeemed (PENDING → ACTIVE).
  phoneE164  String? @unique
  merchantId Int
  locationId Int?
  userId     Int

  status WHATSAPP_LINK_STATUS @default(PENDING)

  // One-time linking code: high-entropy, single-use, short-lived. Cleared on bind.
  linkCode      String?   @unique
  codeExpiresAt DateTime?

  // Conversation reuse: continue activeConversationId while inbound activity is
  // recent (idle window); a "reset"/"new chat" keyword starts a fresh one.
  activeConversationId Int?
  lastInboundAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([userId])
}

// Inbound webhook queue. The webhook validates + enqueues + ACKs 200; the worker
// claims and processes. providerMessageId is unique → Meta redeliveries dedupe.
model WhatsappInboundJob {
  // Internal infra (a queue) — never exposed via the API, so no public uuid (it
  // would only add per-row write/index cost on a hot table). Dedupe/identity is
  // the providerMessageId.
  id Int @id @default(autoincrement())

  // Idempotency key: the Meta `messages[].id`. A redelivered webhook is a no-op.
  providerMessageId String @unique

  phoneE164 String
  payload   Json // the single message object (text or interactive button reply)

  status   WHATSAPP_JOB_STATUS @default(PENDING)
  attempts Int                 @default(0)
  lockedAt DateTime? // visibility-timeout marker for SKIP LOCKED claiming
  error    String?             @db.Text

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

// Stored output of the AI Security Evaluation dashboard. One row per category run
// (e.g. "prompt-injection"): the per-scenario verdicts (`results`) and the
// aggregate `summary` are kept as JSON — the dashboard owns their shape, and we
// only ever read them back wholesale to render the saved report. Scalar
// merchant/createdBy refs (no back-relation) since this is an admin-side artifact,
// not merchant-owned data.
model AiEvalReport {
  id             Int    @id @default(autoincrement())
  aiEvalReportID String @unique @default(uuid())

  merchantId Int
  categoryId String
  // userId that ran the evaluation.
  createdBy  Int

  // Rollup metrics, denormalized from `summary` for cheap listing/filtering.
  totalScenarios   Int
  passedScenarios  Int
  failedScenarios  Int
  averageScore     Int
  criticalFailures Int
  evaluationMethod String
  fallbackCount    Int

  // EvaluationResult[] and the summary object, verbatim from the run.
  results Json
  summary Json

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([categoryId])
}
