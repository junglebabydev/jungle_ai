generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum USER_STATUS {
  ACTIVE
  INACTIVE
  INTERNAL
}

enum SG_REGIONS {
  EAST
  NORTH
  WEST
  NORTH_EAST
  CENTRAL
  SOUTH
}

enum LOCATION_TYPE {
  INDOOR
  OUTDOOR
  BOTH
}

enum PRICE_INDICATOR {
  FREE
  LOW
  MEDIUM
  HIGH
}

enum MimeType {
  IMAGE_JPEG      @map("image/jpeg")
  IMAGE_PNG       @map("image/png")
  IMAGE_WEBP      @map("image/webp")
  IMAGE_GIF       @map("image/gif")
  VIDEO_MP4       @map("video/mp4")
  VIDEO_WEBM      @map("video/webm")
  APPLICATION_PDF @map("application/pdf")
}

// High-level category for a merchant media-library asset. Drives the
// Images / Videos / Audio / Files tabs in the uploads panel. The precise
// browser MIME string is stored separately on MerchantMedia.mimeType.
enum MERCHANT_MEDIA_TYPE {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum PRODUCT_TYPE {
  CLASS
  CAMP
  BIRTHDAY
  DROP_IN
  EVENT
}

enum CLASS_FORMAT {
  PARENT_PARTICIPATION
  PARENT_ACCOMPANIED
  INDEPENDENT
}

enum PRICE_TYPE {
  TERM
  PACKAGE
  SESSION
  TRIAL
  CAMP_WEEK
  CAMP_DAY
  MEMBERSHIP
  PARTY_BASE
  PARTY_ADDON
  DROP_IN_SESSION
}

enum RESIDENCY_TYPE {
  SG_RESIDENT
  SG_NON_RESIDENT
  SG_CITIZENS_PR
}

enum SCHEDULE_TYPE {
  RECURRING
  FIXED_DATE
  DATE_RANGE
}

enum SCHEDULE_STATUS {
  DRAFT
  ACTIVE
  FULL
  CANCELLED
  COMPLETED
}

enum SESSION_STATUS {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FULL
}

enum BOOKING_STATUS {
  REQUESTED
  PROCESSING
  CONFIRMED
  CANCELLED_BY_MERCHANT
  CANCELLED_BY_USER
  COMPLETED
}

enum PAYMENT_STATUS {
  PENDING
  PARTIAL
  COMPLETED
  REFUNDED
  FAILED
}

enum PACKAGE_STATUS {
  ACTIVE
  EXHAUSTED
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum REGISTRATION_STATUS {
  REGISTERED
  WAITLISTED
  CANCELLED
  NO_SHOW
}

enum ENROLLMENT_TYPE {
  PACKAGE
  TRIAL
  DROP_IN
  MAKEUP
  COMP
}

enum ATTENDANCE_STATUS {
  PRESENT
  ABSENT
  LATE
  LEFT_EARLY
  EXCUSED_ABSENCE
}

enum REGISTRATION_CONVERSION_STATUS {
  PENDING
  TRIAL_SCHEDULED
  CONVERTED
  REJECTED
}

enum PACKAGE_KIND {
  TRIAL
  REGULAR
  TERM
  SUBSCRIPTION
  MEMBERSHIP
}

enum RECURRENCE_PATTERN {
  WEEKLY
}

enum BIRTHDAY_VENUE_TYPE {
  AT_HOME
  AT_LOCATION
  BOTH
}

enum BIRTHDAY_ADDON_UNIT {
  PER_KID
  PER_PARENT
  PER_EVENT
}

enum BIRTHDAY_REQUEST_STATUS {
  PENDING
  CONFIRMED
  REJECTED
}

enum DROP_IN_REQUEST_STATUS {
  PENDING
  CONFIRMED
  REJECTED
}

enum DROP_IN_PRICING_UNIT {
  PER_KID
  PER_ADULT
  PER_BOOKING
}

enum DROP_IN_SCHEDULE_KIND {
  WEEKLY
  ONE_OFF
}

// ── Stripe Connect / Subscriptions (Sprint 1 Track 1) ───────────────────────

enum PAYMENT_METHOD {
  CARD
  PAYNOW
  GRABPAY
  OTHER
}

enum STRIPE_PAYMENT_STATUS {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

enum PAYOUT_STATUS {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

enum DISPUTE_STATUS {
  WARNING_NEEDS_RESPONSE
  WARNING_UNDER_REVIEW
  WARNING_CLOSED
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
}

enum PAYMENT_TYPE {
  ONE_TIME
  SUBSCRIPTION
  OFFLINE
}

enum BILLING_INTERVAL {
  WEEK
  MONTH
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String
  createdAt       DateTime         @default(now())
  scope           String
  users           User[]
  merchantUsers   MerchantUser[]
  locationUsers   LocationUser[]
  rolePermissions RolePermission[]

  @@unique([name, scope])
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  description     String?
  scope           String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id     Int    @id @default(autoincrement())
  userID String @default(uuid())

  platformRoleId Int
  platformRole   Role @relation(fields: [platformRoleId], references: [id])

  merchantLocationId Int?
  merchantLocation   Location? @relation(fields: [merchantLocationId], references: [id])

  address    String?
  unitNumber String?
  pinCode    Int?

  email     String  @unique
  phone     String?
  firstName String
  lastName  String

  firebaseId       String
  medicalInfo      String?
  notes            String?
  emergencyContact String?

  status     USER_STATUS @default(ACTIVE)
  isArchived Boolean     @default(false)

  emailVerified           Boolean   @default(false)
  emailVerificationSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantUsers MerchantUser[]
  locationUsers LocationUser[]
  authSessions  AuthSession[]
  bookings      Booking[]

  // Sprint 1 Track 1
  payments Payment[]
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  refreshTokenHash String    @unique
  tokenHash        String    @unique
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  isLoggedOut      Boolean
  loggedOutAt      DateTime?
  signedInAt       DateTime
  lastActiveAt     DateTime  @default(now())
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  ipAddress        String?
  deviceInfo       Json?
}

model Merchant {
  id         Int    @id @default(autoincrement())
  merchantID String @unique @default(uuid())

  name                 String
  businessRegistration String?
  gstRegistered        Boolean @default(false)
  gstNumber            String?

  logoUrl      String?
  brandColor   String?
  contactEmail String?
  contactPhone String?
  webUrl       String?

  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  // Curated shop window: the providers shown to a parent who hasn't said what they
  // want yet. Hand-picked by a platform admin rather than ranked, so it needs to be
  // editable without a deploy. `featuredOrder` sorts the list; null sorts last.
  isFeatured    Boolean @default(false)
  featuredOrder Int?

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations         Location[]
  merchantUsers     MerchantUser[]
  productCategories ProductCategory[]
  registrations     Registration[]
  packageTemplates  PackageTemplate[]
  birthdayRequests  BirthdayRequest[]
  dropInRequests    DropInRequest[]

  // Sprint 1 Track 1 — Stripe Connect
  stripeAccount MerchantStripeAccount?
  payments      Payment[]
  payouts       Payout[]
  disputes      Dispute[]

  // Sprint 2 Track 1 — Jungle SaaS subscription
  jungleSubscription MerchantSubscription?

  // Sprint 2 Track 2 — Website builder
  siteConfig MerchantSiteConfig?

  // Merchant media library (Canva-style uploads panel)
  merchantMedia MerchantMedia[]

  @@index([isFeatured, featuredOrder])
}

model MerchantMedia {
  id              Int    @id @default(autoincrement())
  merchantMediaID String @unique @default(uuid())

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  type      MERCHANT_MEDIA_TYPE
  mimeType  String
  url       String
  // GCS object path (e.g. merchants/<merchantId>/<type>/<folder?>/<uuid>_<name>).
  // Stored explicitly so the object can be deleted without parsing the URL.
  objectKey String              @unique
  fileName  String
  sizeBytes Int
  // Optional user-defined folder for the Folders tab. null = library root.
  folder    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([merchantId, type])
  @@index([merchantId, folder])
}

// newly added - gMapRating: Google Maps rating for the location (0.00 to 5.00)
// newly added - reviewCount: Number of Google Maps reviews for the location
model Location {
  id         Int    @id @default(autoincrement())
  locationID String @unique @default(uuid())

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  name       String
  address    String
  sgDistrict String
  sgRegion   SG_REGIONS
  postalCode String?
  lat        Float?
  long       Float?

  phone    String?
  email    String?
  whatsApp String?

  ageMin Int?
  ageMax Int?

  thumbnail    String?
  locationType LOCATION_TYPE
  gMapUrl      String
  gMapRating   Decimal?      @db.Decimal(10, 2)
  reviewCount  Int?
  tags         String[]

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details           LocationDetails?
  operatingHrs      LocationOperatingHrs[]
  media             LocationMedia[]
  locationUsers     LocationUser[]
  users             User[]
  products          Product[]
  productCategories ProductCategory[]
  students          Student[]
  registrations     Registration[]
  bookings          Booking[]
  packageTemplates  PackageTemplate[]
  packages          Package[]
  schedules         Schedule[]
  sessions          Session[]
  birthdayRequests  BirthdayRequest[]
  dropInSchedules   DropInSchedule[]
  dropInRequests    DropInRequest[]
}

model LocationDetails {
  id           Int      @id @default(autoincrement())
  locationId   Int      @unique
  location     Location @relation(fields: [locationId], references: [id])
  description  String
  termsSummary String?
  termsUrl     String?
  bookingUrl   String?
  webUrl       String?
  email        String?
  instagramUrl String?
  facebookUrl  String?
  phone        String?
  whatsApp     String?

  // The pre-booking questions a venue gets asked and the catalogue could not answer.
  parking           String? @db.Text
  whatToBring       String? @db.Text
  supervisionPolicy String? @db.Text
  amenities         String? @db.Text
}

model LocationOperatingHrs {
  id          Int      @id @default(autoincrement())
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id])
  day         Int
  businessHrs String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LocationMedia {
  id         Int      @id @default(autoincrement())
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
  url        String
  mimeType   MimeType
  sequence   Int?
  createdAt  DateTime @default(now())
}

model MerchantUser {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  merchantId     Int
  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  merchantRoleId Int
  merchantRole   Role      @relation(fields: [merchantRoleId], references: [id])
  isSuspended    Boolean   @default(false)
  joinedAt       DateTime?

  @@unique([userId, merchantId])
  @@index([merchantId, merchantRoleId])
  @@index([userId])
}

model LocationUser {
  id                 Int @id @default(autoincrement())
  userId             Int
  merchantLocationId Int
  locationRoleId     Int

  user             User     @relation(fields: [userId], references: [id])
  merchantLocation Location @relation(fields: [merchantLocationId], references: [id])
  locationRole     Role     @relation(fields: [locationRoleId], references: [id])

  joinedAt DateTime?
  // sessions Session[]
  sessions Session[]

  @@unique([userId, merchantLocationId])
  @@index([merchantLocationId, locationRoleId])
  @@index([userId])
}

model ProductCategory {
  id              Int               @id @default(autoincrement())
  categoryID      String            @unique @default(uuid())
  locationId      Int
  location        Location          @relation(fields: [locationId], references: [id])
  merchantId      Int
  merchant        Merchant          @relation(fields: [merchantId], references: [id])
  name            String
  description     String?
  thumbnail       String?
  isArchived      Boolean           @default(false)
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  products        Product[]
  classes         ClassDetails[]
  campDetails     CampDetails[]
  birthdayDetails BirthdayDetails[]
  dropInDetails   DropInDetails[]
}

model Product {
  id        Int    @id @default(autoincrement())
  productID String @unique @default(uuid())

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  categoryId Int?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  name        String
  description String       @db.Text
  productType PRODUCT_TYPE
  ageMin      Int
  ageMax      Int

  imageUrl     String?
  thumbnailUrl String?
  tags         String[]
  highlights   String[]

  // Nullable on purpose: null means the merchant has not said, false means they
  // said it is not needed. Defaulting to false would let an unanswered question be
  // read as a definite answer, and told to a parent as one.
  bookingRequired Boolean?

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?

  slug            String? @unique
  metaTitle       String?
  metaDescription String?

  // Sprint 1 Track 1 — Stripe payment type
  paymentType     PAYMENT_TYPE      @default(ONE_TIME)
  billingInterval BILLING_INTERVAL?
  intervalCount   Int?
  stripePriceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classDetails       ClassDetails?
  pricings           Pricing[]
  registrations      Registration[]
  bookings           Booking[]
  packageTemplates   PackageTemplate[]
  schedules          Schedule[]
  sessions           Session[]
  sessionEnrollments SessionEnrollment[]
  attendances        Attendance[]
  campDetails        CampDetails?
  productMedias      ProductMedia[]
  campOptions        CampOption[]
  birthdayDetails    BirthdayDetails?
  birthdayAddons     BirthdayAddon[]
  birthdayRequests   BirthdayRequest[]
  dropInDetails      DropInDetails?
  dropInSchedules    DropInSchedule[]
  dropInRequests     DropInRequest[]

  // Sprint 1 Track 1
  payments Payment[]
}

model ProductMedia {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  url      String
  mimeType MimeType
  sequence Int?

  createdAt DateTime @default(now())

  @@index([productId])
}

model ClassDetails {
  id         Int              @id @default(autoincrement())
  classID    String           @unique @default(uuid())
  productId  Int              @unique
  product    Product          @relation(fields: [productId], references: [id])
  categoryId Int?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  format               CLASS_FORMAT
  duration             Int
  maxCapacity          Int
  minEnrollment        Int?
  developmentStage     String?
  skillLevel           String?
  skillLevelCode       String?
  gradeLevel           String?
  prerequisite         String?      @db.Text
  progressionPath      String?      @db.Text
  assessmentRequired   Boolean      @default(false)
  estimatedLessons     Int?
  typicalDurationWeeks Int?

  allowTrials       Boolean @default(true)
  maxTrialsPerChild Int     @default(1)

  requiresPackage      Boolean @default(false)
  allowDropIn          Boolean @default(false)
  isTermBased          Boolean @default(false)
  termLengthWeeks      Int?
  sessionsPerWeek      Int?    @default(1)
  totalSessionsPerTerm Int     @default(1)

  curriculum         String?  @db.Text
  learningObjectives String[]
  materialsIncluded  String?
  materialsRequired  String?
  specialNeeds       Boolean  @default(false)
  ratioRequirement   String?
  dresscode          String?

  // Matches BirthdayDetails and DropInDetails, which already carry this — a parent
  // asks it of a class as readily as of a party.
  cancellationPolicy String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampDetails {
  id     Int    @id @default(autoincrement())
  campID String @unique @default(uuid())

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])

  categoryId Int?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  name        String?
  description String? @db.Text

  venueAddress String?
  lat          Float?
  long         Float?

  nearestMrt String?

  /// Whether a package must be bought to book. Null means the merchant has not said.
  requiresPackage Boolean?
  nearestBusStop  String?
  mealIncluded    Boolean  @default(false)
  busIncluded     Boolean  @default(false)

  discountDetails String? @db.Text
  bookingUrl      String?
  notes           String? @db.Text

  cancellationPolicy String? @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campOptions CampOption[]
}

model CampOption {
  id       Int    @id @default(autoincrement())
  optionID String @unique @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  campDetailsId Int?
  campDetails   CampDetails? @relation(fields: [campDetailsId], references: [id])

  name String

  startDate DateTime
  endDate   DateTime
  startTime String
  endTime   String

  ageMin Int?
  ageMax Int?

  capacity    Int?
  isAvailable Boolean @default(true)

  price     Decimal?    @db.Decimal(10, 2)
  priceType PRICE_TYPE?

  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  registrations Registration[]
  bookings      Booking[]
}

model BirthdayDetails {
  id         Int    @id @default(autoincrement())
  birthdayID String @unique @default(uuid())

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])

  categoryId Int?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  venueType       BIRTHDAY_VENUE_TYPE @default(AT_LOCATION)
  durationMinutes Int?
  /// Whether a package must be bought to book. Null means the merchant has not said.
  requiresPackage Boolean?

  minKids    Int?
  maxKids    Int?
  minParents Int?
  maxParents Int?

  whatsIncluded      String? @db.Text
  cancellationPolicy String? @db.Text

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  birthdayAddons BirthdayAddon[]
}

model BirthdayAddon {
  id              Int    @id @default(autoincrement())
  birthdayAddonID String @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  birthdayDetailsId Int?
  birthdayDetails   BirthdayDetails? @relation(fields: [birthdayDetailsId], references: [id])

  name        String
  description String?

  unit      BIRTHDAY_ADDON_UNIT
  unitPrice Decimal             @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  birthdayRequestAddons BirthdayRequestAddon[]

  @@unique([productId, name])
  @@index([productId, isActive])
}

model BirthdayRequest {
  id                Int    @id @default(autoincrement())
  birthdayRequestID String @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  pricingId Int
  pricing   Pricing @relation(fields: [pricingId], references: [id])

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  parentFullName String
  parentEmail    String?
  parentPhone    String?

  requestedDate   DateTime
  startTime       String?
  durationMinutes Int?

  kidsCount    Int @default(0)
  parentsCount Int @default(0)

  status      BIRTHDAY_REQUEST_STATUS @default(PENDING)
  confirmedAt DateTime?

  notes          String? @db.Text
  customisations String? @db.Text

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  birthdayRequestAddons BirthdayRequestAddon[]
  booking               Booking?

  @@index([merchantId, locationId, status])
  @@index([productId, status])
}

model BirthdayRequestAddon {
  id Int @id @default(autoincrement())

  requestId Int
  request   BirthdayRequest @relation(fields: [requestId], references: [id])

  addonId Int
  addon   BirthdayAddon @relation(fields: [addonId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, addonId])
  @@index([requestId])
  @@index([addonId])
}

model DropInDetails {
  id       Int    @id @default(autoincrement())
  dropInID String @unique @default(uuid())

  productId Int     @unique
  product   Product @relation(fields: [productId], references: [id])

  categoryId Int?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  minKids    Int?
  maxKids    Int?
  minParents Int?
  maxParents Int?

  /// Whether a package must be bought to book. Null means the merchant has not said.
  requiresPackage Boolean?

  whatsIncluded      String? @db.Text
  cancellationPolicy String? @db.Text
  notes              String? @db.Text
  bookingUrl         String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dropInSchedules DropInSchedule[]
}

model DropInSchedule {
  id               Int    @id @default(autoincrement())
  dropInScheduleID String @unique @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  dropInDetailsId Int?
  dropInDetails   DropInDetails? @relation(fields: [dropInDetailsId], references: [id])

  kind DROP_IN_SCHEDULE_KIND

  dayOfWeek Int?
  startTime String?
  endTime   String?

  date          DateTime?
  dateStartTime String?
  dateEndTime   String?

  isActive   Boolean @default(true)
  isArchived Boolean @default(false)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dropInRequests DropInRequest[]

  @@index([productId, isActive])
  @@index([locationId, isActive])
}

model DropInRequest {
  id              Int    @id @default(autoincrement())
  dropInRequestID String @unique @default(uuid())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  scheduleId Int?
  schedule   DropInSchedule? @relation(fields: [scheduleId], references: [id])

  fullName String
  email    String?
  phone    String?

  requestedDate      DateTime?
  requestedDayOfWeek Int?
  requestedStartTime String?
  requestedEndTime   String?

  status      DROP_IN_REQUEST_STATUS @default(PENDING)
  confirmedAt DateTime?

  notes         String? @db.Text
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking?

  dropInRequestItems DropInRequestItem[]

  @@index([merchantId, locationId, status])
  @@index([productId, status])
}

model DropInRequestItem {
  id Int @id @default(autoincrement())

  requestId Int
  request   DropInRequest @relation(fields: [requestId], references: [id])

  pricingId Int
  pricing   Pricing @relation(fields: [pricingId], references: [id])

  quantity Int @default(1)

  pricingNameSnapshot String
  unitPriceSnapshot   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([requestId, pricingId])
  @@index([pricingId])
}

model Pricing {
  id        Int     @id @default(autoincrement())
  pricingID String  @default(uuid())
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  name      String
  price     Decimal    @db.Decimal(10, 2)
  priceType PRICE_TYPE

  dropInUnit DROP_IN_PRICING_UNIT?

  sessionsIncluded Int?
  validityDays     Int?
  canShareSiblings Boolean         @default(false)
  residencyType    RESIDENCY_TYPE?
  ageMin           Int?
