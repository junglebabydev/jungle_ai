# ─────────────────────────────────────────────────────────────────────────────
# jungle_ai (:4006, internal AI compute) — environment template.
# Copy to `.env` and fill every `changeme`. `.env` is gitignored (never commit real secrets).
# Secrets below are masked; config values (ports, URLs, timeouts, model chains) are
# real, sensible defaults you can keep for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# jungle_ai environment — internal-only AI service. Generated from booking_system/.env
# (values mirror booking; shared DB for now — isolated DBs later).

PORT=4006
NODE_ENV=development

# Service-to-service secret. booking's aiClient MUST send this exact value in x-api-key.
JUNGLE_AI_API_KEY=changeme

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/DBNAME?schema=public
OPENROUTER_API_KEY=changeme
OPENROUTER_APP_TITLE=jungle-merchant-config
OPENROUTER_APP_URL=https://jungle.baby
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DATA_POLICY=allow
OPENROUTER_TIMEOUT_MS=30000
AI_MODELS=deepseek/deepseek-v4-pro,google/gemini-3.1-flash-lite,google/gemini-2.5-flash
AI_RATE_MAX=30
AB_MODELS=mistralai/mistral-small-3.2-24b-instruct,openai/gpt-4.1-nano,google/gemini-3.1-flash-lite,google/gemini-2.5-flash-lite,deepseek/deepseek-v4-flash,openai/gpt-5-nano
AI_EVAL_LOCATION_ID=1
AI_EVAL_MERCHANT_ID=1
CONCIERGE_MODELS=google/gemini-3.1-flash-lite,google/gemini-2.5-flash-lite,deepseek/deepseek-v4-flash
CONCIERGE_PROVIDER_ORDER=AtlasCloud,Novita
CONCIERGE_TIMEOUT_MS=15000
SEARCH_ENGINE_URL="http://localhost:4005"
SEARCH_ENGINE_API_KEY=changeme
SEARCH_ENGINE_TIMEOUT_MS=8000
WHATSAPP_ACCESS_TOKEN=changeme
WHATSAPP_APP_SECRET=changeme
WHATSAPP_PHONE_NUMBER_ID=1259631717227453
WHATSAPP_VERIFY_TOKEN=changeme
POSTHOG_API_KEY=changeme
POSTHOG_HOST=https://us.i.posthog.com
GCS_BUCKET="jungle_media_dev"
NOTIFICATION_TEST_MODE=on
NOTIFICATION_TEST_WHATSAPP=919425626656
SALT=changeme

# Poll is only the fallback now — booking kicks the worker on enqueue.
WHATSAPP_WORKER_POLL_MS=20000

# --- Optional / advanced (code defaults shown; uncomment only to override) ---
# PRISMA_LOG_QUERIES=false             # set true to log every SQL query (noisy)
# CONCIERGE_SEARCH_FIRST=false         # run search before the first model round
# CONCIERGE_MAX_STEPS=5                # max tool-loop steps per turn
# CONCIERGE_HISTORY_LIMIT=20           # turns of history sent to the model
# CONCIERGE_RESULTS_PAGE_SIZE=20       # results returned to the client
# CONCIERGE_SEARCH_PAGE_SIZE=8         # results the model sees per search
# CONCIERGE_TURN_TOKEN_BUDGET=80000    # per-turn token budget
# CONCIERGE_VENUE_CATALOG_SIZE=40      # venue catalog size for grounding
# OPENROUTER_MAX_OUTPUT_TOKENS=2000    # cap on model output tokens
# WHATSAPP_RATE_MAX=20                 # inbound WhatsApp msgs / min / sender
# Cache/limit tuning (safe to leave default): CONCIERGE_ACTIVITY_RESOLVE_LIMIT,
# CONCIERGE_DETAIL_LIST_LIMIT, CONCIERGE_DISTRICT_CACHE_TTL_MS,
# CONCIERGE_VENUE_CACHE_MAX, CONCIERGE_VENUE_CACHE_TTL_MS
